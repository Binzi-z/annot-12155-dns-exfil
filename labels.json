{
  "total": 25,
  "rules": {
    "PT-FS-READ-001": {
      "name": "path-traversal-fs-read",
      "shortDescription": "fs 读文件时使用了未净化的动态路径",
      "help": "用户可控片段参与 fs.readFile/readFileSync/createReadStream 的路径计算，且没有 resolve + 前缀校验。"
    },
    "PT-PATH-JOIN-002": {
      "name": "path-traversal-fs-write",
      "shortDescription": "path.join 结果未做目录边界校验就用于写/复制/改名",
      "help": "写文件、复制、改名、删除等操作的目标路径包含未净化输入，可跳出预期目录。"
    },
    "PT-SEND-FILE-003": {
      "name": "path-traversal-send-file",
      "shortDescription": "sendFile/download 使用了动态路径",
      "help": "res.sendFile / res.download 的目标路径由请求参数决定，未做白名单或前缀校验。"
    },
    "PT-DYNAMIC-REQUIRE-004": {
      "name": "path-traversal-dynamic-require",
      "shortDescription": "require 的模块路径包含动态输入",
      "help": "require 的参数由请求、函数入参或环境配置拼成，可加载预期插件目录之外的文件。"
    },
    "PT-STATIC-ROOT-005": {
      "name": "path-traversal-static-root",
      "shortDescription": "express.static 的根目录来自动态输入",
      "help": "静态目录中间件的 root 由租户参数或请求头决定，未做目录边界校验。"
    },
    "PT-ZIP-SLIP-006": {
      "name": "path-traversal-zip-slip",
      "shortDescription": "压缩包条目路径未校验即落盘",
      "help": "解压时直接使用 entryName / entry.path 拼目标路径，可写出 .. 目录。"
    },
    "PT-TEMPLATE-INCLUDE-007": {
      "name": "path-traversal-template-include",
      "shortDescription": "模板 include 的文件名来自动态输入",
      "help": "模板渲染器按用户提供的名字读取 .hbs 片段，未限制在模板目录内。"
    }
  },
